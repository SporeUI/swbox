{
  "name": "@spore-ui/swbox",
  "version": "0.0.0-development",
  "private": true,
  "description": "service-worker 封装方案，便捷管理缓存",
  "main": "dist/swbox.min.js",
  "sideEffects": false,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "upload": "gulp upload",
    "upload:test": "gulp upload-mtest",
    "test": "jest --coverage ./test/unit",
    "tag": "corp-semantic-release --changelogpreset angular-bitbucket --branch develop",
    "release": "npm run tag",
    "prepublishOnly": "./.husky/pre-publish && npm run build",
    "lint": "eslint ./",
    "prepare": "husky install",
    "cz": "git add . && git cz"
  },
  "dependencies": {
    "@spore-ui/tskit": "^0.0.4",
    "lodash": "^4.17.21",
    "node-polyfill-webpack-plugin": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/plugin-transform-runtime": "^7.15.8",
    "@babel/preset-env": "^7.16.0",
    "@commitlint/cli": "^13.2.1",
    "@commitlint/config-conventional": "^13.2.0",
    "@spore-ui/dev-utils": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "babel-jest": "^27.3.1",
    "babel-loader": "^8.2.3",
    "chalk": "^4.1.2",
    "commitizen": "^4.2.4",
    "commitlint": "^13.2.1",
    "conventional-changelog-angular-bitbucket": "^1.2.0",
    "conventional-changelog-cli": "^2.1.1",
    "corp-semantic-release": "^7.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^7.32.0",
    "fkill": "^6.2.0",
    "fs-extra": "^10.0.0",
    "gulp": "^4.0.2",
    "gulp-qcloud-cos-upload": "^1.1.3",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^7.0.4",
    "jest": "^27.3.1",
    "lint-staged": "^11.2.6",
    "react-dev-utils": "^11.0.4",
    "terser-webpack-plugin": "^5.2.4",
    "ts-jest": "^27.0.7",
    "ts-loader": "^9.2.6",
    "typescript": "^4.4.4",
    "url-join": "^4.0.1",
    "webpack": "^5.60.0",
    "webpack-dev-server": "^4.3.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "files": [
    "dist",
    "lib",
    "types",
    "src"
  ],
  "author": "",
  "license": "ISC"
}
